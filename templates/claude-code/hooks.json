{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook session-start",
          "timeout": 20
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook pre-bash",
          "timeout": 20
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook pre-edit",
          "timeout": 20
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook subagent-start",
          "timeout": 20
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook subagent-stop",
          "timeout": 20
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook pre-compact",
          "timeout": 20
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook stop",
          "timeout": 120
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{cli}} hook session-end",
          "timeout": 20
        }
      ]
    }
  ]
}
